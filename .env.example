# Supabase (Required)
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Daily.co (Optional - for Virtual Classroom video/audio)
# MUCH SIMPLER than LiveKit - just one domain!
# Get free account at https://www.daily.co/ (10,000 minutes/month)
# Example: engineerium.daily.co (don't include https://)
VITE_DAILY_DOMAIN=your-subdomain.daily.co

# Gemini API (Required for AI features - EnGo bot)
# Get free API key at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# ElevenLabs (Optional - for human-like AI voice narration)
# Get free API key at https://elevenlabs.io (10,000 chars/month free)
VITE_ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Mixpanel Analytics (Optional - for user analytics)
# Get free token at https://mixpanel.com (100K events/month free)
VITE_MIXPANEL_TOKEN=your-mixpanel-project-token
