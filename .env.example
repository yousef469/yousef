# ============================================
# ENGINEERIUM ENVIRONMENT VARIABLES
# ============================================
# SECURITY NOTE: Never commit .env file to git!
# Copy this file to .env and fill in your values
# ============================================

# Supabase (Required for authentication and database)
# Get your keys from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend Server URL (Required for AI features)
# Deploy your backend to Render, Railway, or similar
VITE_SERVER_URL=https://your-backend.onrender.com

# Daily.co (Optional - for Virtual Classroom video/audio)
# Get free account at https://www.daily.co/ (10,000 minutes/month)
VITE_DAILY_DOMAIN=your-subdomain.daily.co

# Gemini API (Required for AI features - EnGo bot)
# IMPORTANT: For production, use backend proxy to hide API key!
# Get free API key at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Mixpanel Analytics (Optional - for user analytics)
# Get free token at https://mixpanel.com (100K events/month free)
VITE_MIXPANEL_TOKEN=your-mixpanel-project-token

# ============================================
# SECURITY BEST PRACTICES
# ============================================
# 1. Never expose secret keys in frontend code
# 2. Use backend proxy for all API calls
# 3. Enable Row Level Security (RLS) in Supabase
# 4. Use HTTPS in production
# 5. Rotate API keys regularly
