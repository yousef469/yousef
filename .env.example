# Supabase (Required)
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# LiveKit (Optional - for Virtual Classroom video/audio)
# Get these from https://livekit.io/ (free tier: 10,000 minutes/month)
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
VITE_LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxxx
VITE_LIVEKIT_API_SECRET=your-secret-key-here

# Legacy Signaling Server (Old WebRTC - can be removed)
# VITE_SIGNALING_SERVER=https://your-signaling-server.up.railway.app
